@inherits RazorContentComponent<FaqFields>
<section class="service-questions" data-questions>
    <div class="questions-heading"><h2>@Fields.Heading</h2><button type="button" data-toggle-questions aria-expanded="false" hidden>Show all answers</button></div>
    @foreach (var item in Fields.Items) { <details><summary>@item.Question</summary><p>@item.Answer</p></details> }
</section>
